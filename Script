--              NO BALL COLLIDE
-- ════════════════════════════════════════════════════
local function applyBallCollide(state)
    local folder = workspace:FindFirstChild("Footballs")
    if not folder then return end
    for _, v in ipairs(folder:GetChildren()) do
        if v.Name == "Ball" and v:IsA("BasePart") then
            v.CanCollide = state   -- false = sem colisão
        end
    end
end

-- mantém sem colisão se bolas aparecerem depois
RunService.Heartbeat:Connect(function()
    if CFG.NoBallCollide then
        local folder = workspace:FindFirstChild("Footballs")
        if folder then
            for _, v in ipairs(folder:GetChildren()) do
                if v.Name == "Ball" and v:IsA("BasePart") and v.CanCollide then
                    v.CanCollide = false
                end
            end
        end
    end
end)

