    lbTop.Position = UDim2.new(0, 12, 0, 9)
    lbTop.TextXAlignment = Enum.TextXAlignment.Left

    local lbSub = lbl(card, descText, 10, C.subtext, Enum.Font.Gotham)
    lbSub.Size     = UDim2.new(1, -65, 0, 16)
    lbSub.Position = UDim2.new(0, 12, 0, 30)
    lbSub.TextXAlignment = Enum.TextXAlignment.Left
    lbSub.TextWrapped = true

    -- Track + pill
    local track = Instance.new("Frame")
    track.Size             = UDim2.new(0, 44, 0, 22)
    track.Position         = UDim2.new(1, -56, 0.5, -11)
    track.BackgroundColor3 = initState and C.toggle_on or C.toggle_off
    track.Parent           = card
    corner(track, 11)

    local pill = Instance.new("Frame")
    pill.Size              = UDim2.new(0, 16, 0, 16)
    pill.Position          = initState and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
    pill.BackgroundColor3  = C.white
    pill.Parent            = track
    corner(pill, 8)

    local state = initState
    local btn = Instance.new("TextButton")
    btn.Size               = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text               = ""
    btn.Parent             = card
    btn.MouseButton1Click:Connect(function()
        state = not state
        tween(track, { BackgroundColor3 = state and C.toggle_on or C.toggle_off })
        tween(pill, { Position = state and UDim2.new(1,-19,0.5,-8) or UDim2.new(0,3,0.5,-8) })
        callback(state)
    end)

    return card, function() return state end
end

-- Slider
local function mkSlider(labelText, minVal, maxVal, initVal, fmt, callback)
    local card = Instance.new("Frame")
    card.Size             = UDim2.new(1, 0, 0, 70)
    card.BackgroundColor3 = C.panel
    card.Parent           = body
    corner(card, 8)
    stroke(card, C.border)

    local lb = lbl(card, labelText, 12, C.text, Enum.Font.GothamBold)
    lb.Size     = UDim2.new(0.65, 0, 0, 18)
    lb.Position = UDim2.new(0, 12, 0, 8)
    lb.TextXAlignment = Enum.TextXAlignment.Left

    local fmt_str = fmt or "%.2f"
    local valLbl = lbl(card, string.format(fmt_str, initVal), 12, C.accent, Enum.Font.GothamBold)
    valLbl.Size     = UDim2.new(0.35, -12, 0, 18)
    valLbl.Position = UDim2.new(0.65, 0, 0, 8)
    valLbl.TextXAlignment = Enum.TextXAlignment.Right

    local track = Instance.new("Frame")
    track.Size             = UDim2.new(1, -24, 0, 6)
    track.Position         = UDim2.new(0, 12, 0, 36)
    track.BackgroundColor3 = C.border
    track.Parent           = card
    corner(track, 3)

    local fill = Instance.new("Frame")
    fill.Size              = UDim2.new((initVal - minVal)/(maxVal - minVal), 0, 1, 0)
    fill.BackgroundColor3  = C.accent
    fill.Parent            = track
    corner(fill, 3)

    local knob = Instance.new("Frame")
    knob.Size              = UDim2.new(0, 14, 0, 14)
    knob.Position          = UDim2.new((initVal - minVal)/(maxVal - minVal), -7, 0.5, -7)
    knob.BackgroundColor3  = C.white
    knob.Parent            = track
    corner(knob, 7)

    -- min/max labels
    local minL = lbl(card, tostring(minVal), 9, C.subtext, Enum.Font.Gotham)
    minL.Size     = UDim2.new(0, 30, 0, 14)
    minL.Position = UDim2.new(0, 12, 0, 50)
    minL.TextXAlignment = Enum.TextXAlignment.Left
    local maxL = lbl(card, tostring(maxVal), 9, C.subtext, Enum.Font.Gotham)
    maxL.Size     = UDim2.new(0, 30, 0, 14)
    maxL.Position = UDim2.new(1, -42, 0, 50)
    maxL.TextXAlignment = Enum.TextXAlignment.Right

    local dragging = false
    local curVal = initVal

    local function updateSlider(absX)
        local relX = math.clamp((absX - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        curVal = math.floor((minVal + relX * (maxVal - minVal)) * 100 + 0.5) / 100
        fill.Size     = UDim2.new(relX, 0, 1, 0)
        knob.Position = UDim2.new(relX, -7, 0.5, -7)
        valLbl.Text   = string.format(fmt_str, curVal)
        callback(curVal)
    end

    track.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateSlider(inp.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
            updateSlider(inp.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    return card
end

