local CFG = {
    -- Reach (studs) — padrão shoot é Z=2.5, dribble Z=1.5, tackle Z=5.25
    ReachX        = 2.25,
    ReachY        = 5.5,
    ReachZ        = 5.5,
    OffsetY       = -0.5,
    OffsetZ       = -0.25,

    HitboxEnabled = false,
    ShowVisual    = false,
    NoBallCollide = false,
}

-- ════════════════════════════════════════════════════
--                  HOOK — __namecall
-- ════════════════════════════════════════════════════
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()

    if method == "GetPartBoundsInBox" and CFG.HitboxEnabled then
        local args = { ... }
        -- args[1] = CFrame, args[2] = Vector3 size, args[3] = OverlapParams/nil
        if args[1] and typeof(args[1]) == "CFrame"
        and args[2] and typeof(args[2]) == "Vector3"
        then
            -- só modifica se parece o hitbox de toque (Y >= 2 para filtrar outros usos)
            if args[2].Y >= 2 then
                args[2] = Vector3.new(CFG.ReachX, CFG.ReachY, CFG.ReachZ)
            end
        end
        return oldNamecall(self, table.unpack(args))
    end

    return oldNamecall(self, ...)
end)

