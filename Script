--              HITBOX VISUAL — parte que segue HRP
-- ════════════════════════════════════════════════════
local visualPart   = nil
local visualWeld   = nil
local selectionBox = nil

local function buildVisual()
    if visualPart then visualPart:Destroy() end

    local char = lp.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    visualPart = Instance.new("Part")
    visualPart.Name        = "_HBProVisual"
    visualPart.Size        = Vector3.new(CFG.ReachX, CFG.ReachY, CFG.ReachZ)
    visualPart.CFrame      = hrp.CFrame * CFrame.new(0, CFG.OffsetY, CFG.OffsetZ)
    visualPart.CanCollide  = false
    visualPart.CanQuery    = false
    visualPart.CanTouch    = false
    visualPart.Massless    = true
    visualPart.Anchored    = false
    visualPart.Transparency = 1          -- invisível — o SelectionBox desenha
    visualPart.CastShadow  = false
    visualPart.Parent      = workspace.CurrentCamera

    visualWeld          = Instance.new("WeldConstraint")
    visualWeld.Part0    = hrp
    visualWeld.Part1    = visualPart
    visualWeld.Parent   = visualPart

    selectionBox                = Instance.new("SelectionBox")
    selectionBox.Adornee        = visualPart
    selectionBox.Color3         = Color3.fromRGB(0, 255, 120)
    selectionBox.LineThickness  = 0.06
    selectionBox.SurfaceTransparency = 0.85
    selectionBox.SurfaceColor3  = Color3.fromRGB(0, 255, 120)
    selectionBox.Parent         = workspace.CurrentCamera
end

local function destroyVisual()
    if selectionBox then selectionBox:Destroy() selectionBox = nil end
    if visualPart   then visualPart:Destroy()   visualPart   = nil end
    visualWeld = nil
end

-- atualiza tamanho do visual em tempo real
RunService.Heartbeat:Connect(function()
    if CFG.ShowVisual and visualPart then
        visualPart.Size = Vector3.new(CFG.ReachX, CFG.ReachY, CFG.ReachZ)
        -- recalcula weld offset
        local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if hrp and not visualWeld then
            visualWeld          = Instance.new("WeldConstraint")
            visualWeld.Part0    = hrp
            visualWeld.Part1    = visualPart
            visualWeld.Parent   = visualPart
        end
    end
end)

-- reconstrói visual após respawn
lp.CharacterAdded:Connect(function()
    task.wait(1)
    if CFG.ShowVisual then buildVisual() end
end)

